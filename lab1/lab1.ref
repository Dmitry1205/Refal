* Старт
$ENTRY Go {
  = <RunTests <Tests>>;
}

* Тесты
RunTests {
  /* empty */ = /* empty */;
  (e.Test) e.Ost =
    <Parse e.Test>
    <RunTests e.Ost>;
}

Tests {
  = ('^aXbXa$ = ^dXeXl$')
    ('^aXXXb$ = ^aXXXXb$')
    ('^XaXXaX$ = ^XabaX$')
    ('^XasdXsd(X)$ = ^XXaaaXfg$');
}

* Функции для работы со строками
Trim {
  '^' e.Str '$' = e.Str;
  e.Str = e.Str;
}

LTrim {
  '^' e.Str = e.Str;
  e.Str = e.Str;
}

SplitOnX {
  e.Str = <SplitAcc () e.Str>;
}

SplitAcc {
  (e.Part) /* empty */ = (e.Part);
  (e.Part) 'X' e.Rest = (e.Part) <SplitAcc () e.Rest>;
  (e.Part) s.C e.Rest = <SplitAcc (e.Part s.C) e.Rest>;
}

/* Печать: каждое слово с новой строки */
ProutList {
  /* empty */ = /* empty */;
  e.Skip '>' (e.Part) e.Ost = <Prout '[' e.Part ']'>; 
  e.Skip '>' = <Prout 'END'>;
  (e.Part) e.Rest = <Prout '(' e.Part ')'> <ProutList e.Rest>;
}

Parse {
  e.Left ' = ' e.Right =
    <CreateSRS '|START|>' <SplitOnX <LTrim e.Left>> (<FormatRight <SplitOnX <Trim e.Right>>>)>
    <Prout '-------------------'>;

  e.Left '=' e.Right =
    <CreateSRS '|START|>' <SplitOnX <Trim e.Left>>>
    <Prout '-------------------'>;

  e.Str = <Prout 'Ошибка: нет = в строке'>;
}

IndexList {
  e.Skip '>' () e.Ost = '[EMPTY]';
  e.Skip '>' (e.Part) e.Ost = e.Part;
  e.Skip '>' = 'END';
  e.List = <FormatList e.List>;
}

FormatList {
  /* empty */ = /* empty */;
  (e.Part) = '(' e.Part ')';
  (e.Part) e.Rest = '(' e.Part ')' <FormatList e.Rest>;
}

/* Формат правой части: {} вместо X, слова без скобок */
FormatRight {
  /* empty */ = /* empty */;
  (e.Word) = e.Word;
  (e.Word) e.Rest = e.Word '{}' <FormatRight e.Rest>;
}

* -------------------------------------------------------

NextIter {
  e.Left '>' (e.Next) e.Right = e.Left (e.Next) '>' e.Right;
  e.Left '>' = e.Left '>';
  e.List = '>' e.List;
}

BackIter {
  e.Left (e.Prev) '>' e.Right = e.Left '>' (e.Prev) e.Right;
  '>' e.Right = '>' e.Right;
  e.List = e.List '>';
}

* ------------------------------------------------------

CreateSRS {
  e.Str1 '>' (e.Right) = <Prout '$! -> <|DEL|?' e.Right '$'>
                               <Prout 'GAMMA<|DEL| -> <|DEL|'>
                               <Prout ']<|DEL| -> <|OK|]'>
                               <Prout 'GAMMA<|OK| -> <|OK|GAMMA'>
                               <Prout '[GAMMA<|OK| -> GAMMA[|NAR|>|GAMMA|'>
                               <Prout '|NAR|>|GAMMA|GAMMA -> GAMMA|NAR|>|GAMMA|'>
                               <Prout '|NAR|>|GAMMA|} -> GAMMA}|NAR|>|GAMMA|'>
                               <Prout '|NAR|>$ -> <|OK|$'>
                               <Prout '[]<|OK| -> <|ALL|'>
                               <Prout 'GAMMA<|ALL| -> <|ALL|'>
                               <Prout '%<|ALL| -> |ALL|>'>
                               <Prout '|ALL|>GAMMA -> |ALL|>'>
                               <Prout '|ALL|>? -> ^|CLR|>'>
                               <Prout '|CLR|>GAMMA -> GAMMA|CLR|>'>
                               <Prout '|CLR|>{ -> |CLR|>'>
                               <Prout '|CLR|>} -> |CLR|>'>
                               <Prout '|CLR|>$ -> $'>;

  '|START|' e.Str1 (e.Right) = <Prout '^ -> %' '|FIRST|>' '|' <IndexList e.Str1> '|'>
                   <Prout '|FIRST|>|' <IndexList e.Str1> '|' <IndexList e.Str1> '  ->  ' <IndexList e.Str1> '[' '@' '>|' <IndexList <NextIter e.Str1>> '|'>
                   <Prout '|FIRST|>|' <IndexList e.Str1> '|' 'GAMMA' ' -> ' '|END|<GAMMA'>
                   <Prout 'GAMMA|END|< -> |END|<GAMMA'>
                   <Prout '%|END|< -> ^' >
                   <CreateSRS '|SECOND|' <NextIter e.Str1> (e.Right)>;



  '|SECOND|' e.Str1 (e.Right) = <Prout '>|' <IndexList e.Str1> '|' <IndexList e.Str1> ' -> ' '<|UK|]' <IndexList e.Str1> '!'>
                      <Prout '>|' <IndexList e.Str1> '|' 'GAMMA' ' -> ' 'GAMMA>|' <IndexList e.Str1> '|'>
                      <Prout 'GAMMA<|UK| -> <|UK|GAMMA'>
                      <Prout '@GAMMA<|UK| -> GAMMA@|SR|>|' 'GAMMA' '|'>
                      <Prout '|SR|>|GAMMA|' 'GAMMA -> GAMMA|SR|>|GAMMA|'>
                      <Prout '|SR|>|GAMMA|!GAMMA -> <|UK|GAMMA!'>
                      
                      <Prout '|SR|>|GAMMA|!BETA -> |BACK|<|' <IndexList <BackIter e.Str1>> '|BETA'>
                      <Prout ']' <IndexList <BackIter e.Str1>> '|BACK|< -> ' <IndexList <BackIter e.Str1>> '>|' <IndexList <BackIter e.Str1>> '|'>
                      <Prout '@<|BACK| -> <|BACK|'>
                      <Prout 'GAMMA|BACK|<|' <IndexList <BackIter e.Str1>>'| -> ' '|BACK|<|' <IndexList <BackIter e.Str1>>  '|GAMMA'>
                      <Prout '@]|UK|< -> ]|SKIP!|>|' <IndexList <NextIter e.Str1>> '|'>
                      <Prout '|SKIP!|>|' <IndexList <NextIter e.Str1>> '|GAMMA -> GAMMA|SKIP!|>|' <IndexList <NextIter e.Str1>> '|'>
                      <Prout '|SKIP!|>|' <IndexList <NextIter e.Str1>> '|! -> >|' <IndexList <NextIter e.Str1>> '|'>
                      <Prout '>|' <IndexList <NextIter e.Str1>> '|' <IndexList <NextIter e.Str1>> ' -> <|UK|' <IndexList <NextIter e.Str1>> '!'>
*                      <Prout '>|' <IndexList <NextIter e.Str1>> '|' <IndexList <NextIter e.Str1>> ' -> '>
                      <CreateSRS <NextIter <NextIter e.Str1>> (e.Right)>;
*                      <Prout '>|' <IndexList <NextIter e.Str1>> 'GAMMA -> GAMMA >|' <IndexList <NextIter e.Str1>> '|'>;
                      
  '|THIRD|' e.Str1 (e.Right) = <>;
    e.Str = <Prout e.Str>;
}
